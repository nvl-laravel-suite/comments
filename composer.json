{
    "name": "nvl/comments",
    "description": "Polymorphic threaded comments, reactions, moderation, reports, revisions, and media attachments for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "comments",
        "threads",
        "reactions",
        "moderation"
    ],
    "require": {
        "ext-filter": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^12.0 || ^13.0",
        "nvl/core": "^5.1",
        "nvl/filterable": "^5.0",
        "php": "^8.4",
        "spatie/laravel-data": "^4.23",
        "symfony/http-foundation": "^7.2 || ^8.0",
        "symfony/polyfill-intl-normalizer": "^1.33"
    },
    "require-dev": {
        "ext-pcntl": "*",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nvl/media": "^5.1",
        "nvl/ownership": "^5.0",
        "nvl/tenancy": "^5.0",
        "nvl/translatable": "^5.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "spatie/typescript-transformer": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Comments\\": "src/",
            "Nvl\\Comments\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Comments\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "5.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Comments\\Providers\\CommentsServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests",
            "/.DS_Store",
            "/**/.DS_Store",
            "/.gitattributes",
            "/**/.gitattributes",
            "/.gitignore",
            "/**/.gitignore",
            "/**/.gitkeep"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "nvl/media": "Enables private authorized comment attachments, signed asset delivery, and historical attachment cleanup.",
        "nvl/ownership": "Adds optional model-declared ownership, isolation, adoption and captured worker contexts.",
        "nvl/tenancy": "Temporary legacy tenancy bridge for existing tenant installations; native ownership does not require it.",
        "spatie/typescript-transformer": "Consume the declared TypeScript attributes and metadata (^3.3); Core retains the runtime transformation engine."
    },
    "conflict": {
        "nvl/media": "<5.1 || >=6.0",
        "nvl/ownership": "<5.0 || >=6.0",
        "nvl/tenancy": "<5.0 || >=6.0"
    },
    "homepage": "https://github.com/nvl-laravel-suite/comments",
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/nvl-laravel-suite/comments",
        "docs": "https://github.com/nvl-laravel-suite/comments#readme",
        "issues": "https://github.com/nvl-laravel-suite/comments/issues",
        "security": "https://github.com/nvl-laravel-suite/comments/security/policy"
    }
}
