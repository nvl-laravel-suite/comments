{
    "name": "nvl/comments",
    "description": "Polymorphic threaded comments, reactions, moderation, reports, revisions, and media attachments for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "comments", "threads", "reactions", "moderation"],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^13.0",
        "nvl/data": "^2.0",
        "nvl/filterable": "^2.0",
        "nvl/media": "^2.0",
        "nvl/support": "^2.0",
        "spatie/laravel-data": "^4.23",
        "spatie/typescript-transformer": "^3.3",
        "symfony/http-foundation": "^7.2 || ^8.0"
    },
    "require-dev": {
        "ext-pcntl": "*",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "nvl/translatable": "^2.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Comments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Comments\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": ["@format:test", "@analyse", "@test"],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Comments\\Providers\\CommentsServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": ["/.temp", "/build", "/coverage", "/.phpunit.cache", "/.phpunit.result.cache"]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
